# ─── APPLICATION ENVIRONMENT CONFIGURATION ───
# "development" or "production"
NODE_ENV=development
# The port the Express server will listen on
PORT=5000
# Optional: Application version tracker
APP_VERSION=1.0.0

# ─── DATABASE CONFIGURATION ───
# MongoDB connection string (Local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/multi_tenant_ecommerce

# ─── SECURITY & AUTHENTICATION ───
# Secret key used for signing JWTs (Must be at least 32 characters in production)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# JWT duration format (e.g., "7d", "24h")
JWT_EXPIRE=7d

# ─── CORS CONFIGURATION ───
# Comma-separated list of allowed frontend origins (No trailing slashes)
# In production, replace this with your Vercel deployment URL
CLIENT_URLS=http://localhost:5173

# ─── STRIPE INTEGRATION (PAYMENTS) ───
# Stripe secret API key (Use sk_test_xxx for mock payment mode fallback)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe publishable key (Optional on backend, used for reference)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Stripe webhook secret (Obtained from stripe CLI or dashboard listener)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── CLOUDINARY INTEGRATION (IMAGE UPLOAD) ───
# Cloudinary credentials for product/store logo uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── SMTP EMAIL CONFIGURATION ───
# Configuration for Nodemailer email delivery (Welcome emails, updates)
# If left blank, the app automatically falls back to Ethereal test accounts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The email sender header (name and address)
FROM_EMAIL="Multi-Tenant Ecom <noreply@example.com>"
