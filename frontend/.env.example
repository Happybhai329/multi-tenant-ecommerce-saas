# ─── FRONTEND CONFIGURATION ───
# Base URL for the backend API.
# - For local development: Leave as "/api" to utilize Vite's dev proxy (which maps to http://localhost:5000).
# - For production: Set to your fully qualified backend Render domain (e.g., "https://multi-tenant-ecommerce-api.onrender.com/api").
VITE_API_BASE_URL=/api

# ─── STRIPE (OPTIONAL) ───
# Stripe publishable key — required if you enable real client-side Stripe Elements (e.g., CardElement).
# Not needed when PAYMENT_MOCK_MODE=true on the backend (current default for demos).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
